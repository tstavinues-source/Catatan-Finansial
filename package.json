{
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3"
  },
  "description": "AuraFi — aplikasi keuangan pribadi (web + pembungkus Android via Capacitor)",
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  },
  "name": "aurafi",
  "private": true,
  "scripts": {
    "android:setup": "npm run sync:www && npx cap add android && npx cap sync android",
    "android:sync": "npm run sync:www && npx cap sync android",
    "sync:www": "node scripts/sync-www.mjs",
    "capacitor:sync:after": "node scripts/apply-android-extras.mjs"
  },
  "version": "1.0.0"
}
